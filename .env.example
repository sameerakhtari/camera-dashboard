# ============================================================
# Camera Dashboard
# Copy this file to .env and replace the example values.
# NEVER commit your real .env file.
# ============================================================

# Dashboard
DASHBOARD_PORT=8085
TZ=Asia/Karachi

# ------------------------------------------------------------
# LuxBridge solar inverter REST endpoint
# host.docker.internal points back to the Docker host because
# docker-compose.yml adds host-gateway on Linux.
# ------------------------------------------------------------
SOLAR_URL=http://host.docker.internal:8099/api/v1/live
SOLAR_INTERVAL=3

# ------------------------------------------------------------
# Camera compatibility output sent to the old Android browser
# These settings DO NOT change camera/Frigate stream quality.
#
# FFmpeg q:v scale: lower = better JPEG quality, 2 is very high,
# 5 is a good starting point for a 4-camera dashboard.
# ------------------------------------------------------------
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_FPS=8
CAMERA_JPEG_QUALITY=5
CAMERA_RECONNECT_DELAY=2

# ------------------------------------------------------------
# Camera 1
# Hikvision sub-stream is normally channel 102.
# Prefer HOST/USER/PASS so special characters in the password
# are URL-encoded automatically by the application.
# ------------------------------------------------------------
CAM1_NAME=Gate
CAM1_HOST=192.168.1.101
CAM1_USER=admin
CAM1_PASS=change_me
CAM1_CHANNEL=102

# Camera 2
CAM2_NAME=Front
CAM2_HOST=192.168.1.102
CAM2_USER=admin
CAM2_PASS=change_me
CAM2_CHANNEL=102

# Camera 3
CAM3_NAME=Back
CAM3_HOST=192.168.1.103
CAM3_USER=admin
CAM3_PASS=change_me
CAM3_CHANNEL=102

# Camera 4 - leave CAM4_HOST blank until a fourth camera exists
CAM4_NAME=Camera 4
CAM4_HOST=
CAM4_USER=
CAM4_PASS=
CAM4_CHANNEL=102

# ------------------------------------------------------------
# Optional weather via Open-Meteo.
# Leave blank to hide weather data.
# Example only:
# WEATHER_LAT=24.8607
# WEATHER_LON=67.0011
# ------------------------------------------------------------
WEATHER_LAT=
WEATHER_LON=
WEATHER_INTERVAL=600
